# Local programme editor (/admin). Not used in production - the admin routes answer 404 there.
ADMIN_PASSWORD=choose-a-long-passphrase
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Student portal (Supabase -> Project Settings -> API). The URL and publishable key are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only, bypasses row-level security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Owners: comma-separated Google emails that are always admins. Add other staff and admins on the portal's Team page.
ADMIN_EMAILS=
