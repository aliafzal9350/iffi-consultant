# Student portal (Supabase -> Project Settings -> API). The URL and publishable key are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only, bypasses row-level security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Owners: comma-separated Google emails that are always admins. Add other staff and admins on the portal's Team page.
ADMIN_EMAILS=
# Emails to students and to the IFFI inbox (Gmail SMTP). Turn on 2-Step Verification for the Google account, then create an
# App Password (Google Account -> Security -> App passwords) and paste the 16 letters here. Without these, no email is sent.
SMTP_USER=ifficonsultant@gmail.com
SMTP_PASS=
# Optional: where staff alerts go (default: the contact email), and the site address used in email links while the domain is not live
STAFF_NOTIFY_EMAIL=
APP_URL=
